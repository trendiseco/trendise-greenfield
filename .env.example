TRENDISE_ENV=development
MOCK_ONLY=true
API_PORT=4100
DATABASE_URL=postgresql://trendise:trendise_dev_only@127.0.0.1:5434/trendise_dev
NEXT_PUBLIC_API_BASE=http://localhost:4100

# Optional Shiprocket sandbox rate lookup for private UAT
SHIPROCKET_RATE_LOOKUP=false
SHIPROCKET_RATE_ENV=sandbox
SHIPROCKET_PICKUP_PIN=501505
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# Optional. Set the same secret in Shiprocket and the TRENDISE backend.
SHIPROCKET_WEBHOOK_SECRET=

# Optional private real-SMS UAT. Enable Phone sign-in and configure an SMS provider in Supabase first.
CUSTOMER_OTP_MODE=mock
SUPABASE_AUTH_URL=
SUPABASE_AUTH_PUBLISHABLE_KEY=
# Enable only after configuring the Google provider in Supabase.
CUSTOMER_GOOGLE_ENABLED=false
# Comma-separated Indian numbers you control. Required in supabase-uat mode.
CUSTOMER_OTP_TEST_NUMBERS=

# For MSG91 instead, set CUSTOMER_OTP_MODE=msg91-uat and the same test-number allowlist.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
# Browser widget mode keeps MSG91 CAPTCHA enabled.
MSG91_WIDGET_TOKEN=
