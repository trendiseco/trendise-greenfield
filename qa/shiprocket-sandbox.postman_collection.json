{
  "info": {
    "name": "TRENDISE Shiprocket Sandbox Diagnostics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login probe without credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://api-sandbox.shiprocket.in/v1/external/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Authenticate sandbox API user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://api-sandbox.shiprocket.in/v1/external/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{vault:shiprocket-sandbox-email}}\",\n  \"password\": \"{{vault:shiprocket-sandbox-password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Courier rates for sample COD parcel",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{vault:shiprocket-sandbox-token}}"
          }
        ],
        "url": "https://api-sandbox.shiprocket.in/v1/external/courier/serviceability?pickup_postcode=501505&delivery_postcode=110001&weight=0.5&cod=1"
      }
    }
  ]
}
